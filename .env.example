NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Vercel AI Gateway: production uses Vercel OIDC automatically.
# For local development outside Vercel, set AI_GATEWAY_API_KEY.
AI_GATEWAY_API_KEY=
OPENAI_MODEL=openai/gpt-6-astra
OPENAI_CODE_MODEL=openai/gpt-6-astra

# Vercel Sandbox authentication: deployed Vercel functions can use OIDC.
# Token/team/project are only a fallback for external/local runtimes.
VERCEL_OIDC_TOKEN=
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
