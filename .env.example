NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only control-plane secret key; never expose with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Direct OpenAI API. This key is used server-side only.
# The runtime explicitly calls https://api.openai.com/v1 and does not rely on Vercel AI Gateway.
OPENAI_DIRECT_API_KEY=
OPENAI_DIRECT_TIMEOUT_MS=120000

# Cost-aware defaults: Luna plans; Sol handles code, repair, edits, and visual QA.
# Each primary model has a fallback so a transient/model-specific failure does not stop the pipeline.
OPENAI_MODEL=gpt-6-luna
OPENAI_FALLBACK_MODEL=gpt-6.1-sol
OPENAI_CODE_MODEL=gpt-6.1-sol
OPENAI_CODE_FALLBACK_MODEL=gpt-6-luna
OPENAI_REPAIR_MODEL=gpt-6.1-sol
OPENAI_REPAIR_FALLBACK_MODEL=gpt-6-luna
OPENAI_EDIT_MODEL=gpt-6.1-sol
OPENAI_EDIT_FALLBACK_MODEL=gpt-6-luna
OPENAI_VISION_MODEL=gpt-6.1-sol
OPENAI_VISION_FALLBACK_MODEL=gpt-6-luna

# Vercel Sandbox
VERCEL_OIDC_TOKEN=
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=

# Supabase for Platforms — server-side only
SUPABASE_MANAGEMENT_TOKEN=
SUPABASE_PLATFORM_ORG_SLUG=
SUPABASE_SMART_REGION=americas
SUPABASE_MAX_BACKENDS_PER_USER=3

# GitHub App — server-side only
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Random secret >=32 characters for signed install/OAuth state.
GITHUB_OAUTH_STATE_SECRET=
# GitHub App webhook secret.
GITHUB_WEBHOOK_SECRET=
# Exactly 32 random bytes, base64 encoded, used for AES-256-GCM token encryption.
GITHUB_TOKEN_ENCRYPTION_KEY=
